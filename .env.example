# Copy to .env in this project folder. Loaded automatically; restart after edits.
# Process environment > .env > previously saved local settings > defaults.
# Keep this file private once you add real keys. Do not put keys in frontend code.
TRENDFORGE_PORT=8765
TRENDFORGE_AI_ENGINE=workbuddy

# Accounts. Creators register with a username, a password and this shared invite code.
# Empty disables registration (existing accounts can still sign in). Use a long random value.
TRENDFORGE_INVITE_CODE=
# Comma-separated usernames that may change shared workspace settings (speech model).
TRENDFORGE_ADMIN_USERNAMES=

# With URL + token configured, Turso is selected automatically. No silent fallback.
# TRENDFORGE_DATABASE_BACKEND=turso
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Video storage: local (this computer's data folder) or cos (Tencent Cloud Object Storage).
TRENDFORGE_STORAGE_BACKEND=local
# For cos: bucket name includes the APPID, e.g. trendforge-1250000000; region e.g. ap-singapore or ap-jakarta.
# Use a sub-account key limited to this bucket. The endpoint defaults to https://cos.<region>.myqcloud.com.
TRENDFORGE_COS_BUCKET=
TRENDFORGE_COS_REGION=
TRENDFORGE_COS_SECRET_ID=
TRENDFORGE_COS_SECRET_KEY=
# TRENDFORGE_COS_ENDPOINT=

# Video worker: embedded (runs inside this service; local use) or external (a separate
# `python -m trendforge.worker` process or the Dockerfile.worker container).
TRENDFORGE_WORKER=embedded

# Service credentials are managed once by the workspace owner.
# Empty values disable that service, even if an older key was saved in Connections.
YOUTUBE_API_KEY=
PEXELS_API_KEY=

# Temporary default stock provider. Set to pexels to switch back later.
TRENDFORGE_STOCK_PROVIDER=pixabay
PIXABAY_API_KEY=

# WorkBuddy runs the AI using its own signed-in account and TrendForge connector.
# There is no WorkBuddy model API key to enter in the website.

# Optional alternative writing engine, only when explicitly enabled:
# TRENDFORGE_AI_ENGINE=openai_compatible
# AI_BASE_URL=https://your-provider.example/v1
# AI_MODEL=your-model-id
# AI_API_KEY=

# Local speech recognition needs no API key. Download the selected model once.
# TRENDFORGE_SPEECH_MODEL=base
# TRENDFORGE_DATA_DIR=C:/path/to/private/trendforge-data
# FFMPEG_BINARY=C:/path/to/ffmpeg.exe

